# コピーして .env にリネームし、値を設定してください
# （.env は .gitignore 済みでコミットされません）

# Admin 認証（必須）
ADMIN_USERNAME=your_admin_name
# 12文字以上の強力なパスワード（未設定・短すぎると起動に失敗します）
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# セッション署名用シークレット（例: python -c "import secrets;print(secrets.token_hex(32))"）
# 複数プロセス/複数マシンで運用する場合は必ず固定値を設定する
ADMIN_SECRET=REPLACE_WITH_RANDOM_HEX

# 任意
#ADMIN_COOKIE_SECURE=1
#ADMIN_MAX_LOGIN_FAILS=5
#ADMIN_LOCK_MINUTES=10
#ADMIN_ALLOWED_IPS=203.0.113.10,203.0.113.11

# サーバー設定
HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=0

# --- カード画像生成（同時実行制限 + 待ち行列） ---
# 同時に生成する最大スレッド数（サイト全体フリーズ防止）
CARD_GEN_MAX_WORKERS=2
# 待ち行列の上限。実行中+待ち が workers+queue を超えると 503
CARD_GEN_MAX_QUEUE=20
# 画像メモリキャッシュの寿命（秒）。経過後に全クリアしてメモリ解放（既定300）
#CARD_CACHE_TTL_SEC=300
# 秒指定が無い場合のみ時間が使われる（旧設定との互換）
#CARD_CACHE_TTL_HOURS=12

# --- 画像メモリキャッシュのバイト予算（各MB）。合計がメモリ使用の天井になる ---
# 元の大きい画像（スプラッシュぼかし=1枚15MB級等）を予算で管理し、RSS の膨張を防ぐ
#CACHE_IMAGES_MB=64
#CACHE_RESIZED_MB=64
#CACHE_SPLASH_BLUR_MB=96
#CACHE_REGION_BGS_MB=48
#CACHE_LAYERS_MB=64
#CACHE_MASKS_MB=16
# フォントキャッシュの件数上限
#FONT_CACHE_MAX=256
# JSONデータキャッシュの件数上限（mtime 変化で自動無効化）
#JSON_CACHE_MAX_ENTRIES=192

# --- 生成カードのサーバー側ディスクキャッシュ（cache=server 時） ---
# ディスク使用量の上限（MB）。超過時は使われていないものから削除
#CARD_DISK_CACHE_MB=512
# 画像レスポンスの Cache-Control max-age（秒）。0 で no-store
#CARD_HTTP_CACHE_MAX_AGE=600

# --- カード画像URL署名（エンドポイント秘匿化 / DDoS対策） ---
# /generate_card_image を直接叩かれても生成前に拒否するためのHMAC署名シークレット。
# 必ず固定のランダム値を設定する（未設定の間は署名なしで動作し、防御は無効）
# 例: python -c "import secrets;print(secrets.token_hex(32))"
CARD_URL_SECRET=REPLACE_WITH_RANDOM_HEX
# 署名の有効時間（時間）。ブラウザキャッシュ寿命と同じ12を推奨
CARD_SIGN_VALIDITY_HOURS=12
# 署名取得（/api/card_sign）のIP毎レート上限（回/分）。0で無効
CARD_SIGN_RATE_LIMIT_PER_MIN=60
# 画像生成のIP毎レート上限（回/分）。Cloudflare直結で全ユーザーが
# 同一エッジIPに見える構成では高めに設定するか0（無効）を推奨
CARD_GEN_RATE_LIMIT_PER_MIN=0

# --- Discord エラー通知（任意） ---
# 未設定ならコンソールのみ。Webhook URL は Discord チャンネル設定から取得
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
#DISCORD_WEBHOOK_USERNAME=Artifacter Error
# 同一プロセス内の最小送信間隔（秒）。連打抑制
#DISCORD_MIN_INTERVAL_SEC=2

# --- 編成共有データの保存先（share_data） ---
# local=プロジェクト直下 share_data/（既定）/ r2=Cloudflare R2（実機と開発サーバーで同じデータを共有）
# r2 設定が不正な場合は起動時に warning を出して local にフォールバックする
SHARE_BACKEND=local
# R2 のダッシュボード -> R2 API トークンで発行（バケットは private のまま運用）
#R2_ACCOUNT_ID=
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=share-data

# --- Discord bot（bot/bot.py・Admin パネルの「Bot管理」から制御） ---
# Discord bot トークン（未設定なら bot は起動しない。DISCORD_BOT_TOKEN でも可）
# Discord Developer Portal -> 対象アプリケーション -> Bot -> Token
NEWBC_BOT_TOKEN=
# new_bc API のベースURL。未設定なら http://127.0.0.1:$PORT を使用
#NEW_BC_API_URL=http://127.0.0.1:8000
# 開発用: コマンド同期を単一ギルドに限定するギルドID（空欄ならグローバル同期）
#GUILD_ID=
# サーバー起動時に bot を自動起動（0 で無効）
NEWBC_BOT_AUTOSTART=1
# /admin コマンドを実行できる Discord ユーザーID（自分のID。カンマ区切りで複数可）
# 未設定の場合は誰も /admin を実行できない
ADMIN_DISCORD_USERID=

TOIAWASE_webhook=https://discord.com/api/webhooks/...