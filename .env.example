# コピーして .env にリネームし、値を設定してください
# （.env は .gitignore 済みでコミットされません）

# Admin 認証（必須）
ADMIN_USERNAME=your_admin_name
# 12文字以上の強力なパスワード（未設定・短すぎると起動に失敗します）
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# セッション署名用シークレット（例: python -c "import secrets;print(secrets.token_hex(32))"）
# 複数プロセス/複数マシンで運用する場合は必ず固定値を設定する
ADMIN_SECRET=REPLACE_WITH_RANDOM_HEX

# 任意
#ADMIN_COOKIE_SECURE=1
#ADMIN_MAX_LOGIN_FAILS=5
#ADMIN_LOCK_MINUTES=10
#ADMIN_ALLOWED_IPS=203.0.113.10,203.0.113.11

# サーバー設定
HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=0
