# コピーして .env にリネームし、値を設定してください
# （.env は .gitignore 済みでコミットされません）

# Admin 認証（必須）
ADMIN_USERNAME=your_admin_name
# 12文字以上の強力なパスワード（未設定・短すぎると起動に失敗します）
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# セッション署名用シークレット（例: python -c "import secrets;print(secrets.token_hex(32))"）
# 複数プロセス/複数マシンで運用する場合は必ず固定値を設定する
ADMIN_SECRET=REPLACE_WITH_RANDOM_HEX

# 任意
#ADMIN_COOKIE_SECURE=1
#ADMIN_MAX_LOGIN_FAILS=5
#ADMIN_LOCK_MINUTES=10
#ADMIN_ALLOWED_IPS=203.0.113.10,203.0.113.11

# サーバー設定
HOST=0.0.0.0
PORT=8000
UVICORN_RELOAD=0

# --- カード画像生成（同時実行制限 + 待ち行列） ---
# 同時に生成する最大スレッド数（サイト全体フリーズ防止）
CARD_GEN_MAX_WORKERS=2
# 待ち行列の上限。実行中+待ち が workers+queue を超えると 503
CARD_GEN_MAX_QUEUE=20
# 画像キャッシュ（splash blur 等）の寿命（時間）。経過後にクリア
CARD_CACHE_TTL_HOURS=12

# --- カード画像URL署名（エンドポイント秘匿化 / DDoS対策） ---
# /generate_card_image を直接叩かれても生成前に拒否するためのHMAC署名シークレット。
# 必ず固定のランダム値を設定する（未設定の間は署名なしで動作し、防御は無効）
# 例: python -c "import secrets;print(secrets.token_hex(32))"
CARD_URL_SECRET=REPLACE_WITH_RANDOM_HEX
# 署名の有効時間（時間）。ブラウザキャッシュ寿命と同じ12を推奨
CARD_SIGN_VALIDITY_HOURS=12
# 署名取得（/api/card_sign）のIP毎レート上限（回/分）。0で無効
CARD_SIGN_RATE_LIMIT_PER_MIN=60
# 画像生成のIP毎レート上限（回/分）。Cloudflare直結で全ユーザーが
# 同一エッジIPに見える構成では高めに設定するか0（無効）を推奨
CARD_GEN_RATE_LIMIT_PER_MIN=0

# --- Discord エラー通知（任意） ---
# 未設定ならコンソールのみ。Webhook URL は Discord チャンネル設定から取得
#DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/yyyyyyyy
#DISCORD_WEBHOOK_USERNAME=Artifacter Error
# 同一プロセス内の最小送信間隔（秒）。連打抑制
#DISCORD_MIN_INTERVAL_SEC=2

TOIAWASE_webhook=https://discord.com/api/webhooks/...